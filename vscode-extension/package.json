{
  "name": "repo-intelligence-agent",
  "displayName": "ARIA",
  "description": "Bring repository intelligence directly into VS Code with ARIA — symbol hover, CodeLens, interactive graphs, chat, and more.",
  "version": "0.1.0",
  "publisher": "repo-intelligence",
  "author": "Varshith Reddy",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/VarshithReddy2006/Repo-Intelligence-Agent.git"
  },
  "bugs": {
    "url": "https://github.com/VarshithReddy2006/Repo-Intelligence-Agent/issues"
  },
  "homepage": "https://github.com/VarshithReddy2006/Repo-Intelligence-Agent",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Visualization",
    "Programming Languages"
  ],
  "keywords": [
    "architecture",
    "dependency graph",
    "call graph",
    "code intelligence",
    "chat"
  ],
  "activationEvents": [
    "onView:repoIntelligenceExplorer",
    "onView:repoIntelligenceFindings",
    "onView:repoIntelligenceAdvisor",
    "onView:repoIntelligenceExecution",
    "onView:repoIntelligenceConnection",
    "onCommand:repoIntelligence.analyzeRepository",
    "onCommand:repoIntelligence.refreshAnalysis",
    "onCommand:repoIntelligence.setActiveRepository",
    "onCommand:repoIntelligence.showDependencyGraph",
    "onCommand:repoIntelligence.showCallGraph",
    "onCommand:repoIntelligence.showAPISurface",
    "onCommand:repoIntelligence.showRepositoryChat",
    "onCommand:repoIntelligence.showReadingPath",
    "onCommand:repoIntelligence.openDashboard",
    "onCommand:repoIntelligence.openWorkspace",
    "onCommand:repoIntelligence.openFindings",
    "onCommand:repoIntelligence.openAdvisor",
    "onCommand:repoIntelligence.openTimeline",
    "onCommand:repoIntelligence.openMonitoring",
    "onCommand:repoIntelligence.openExecutionPlan",
    "onCommand:repoIntelligence.refreshWorkspace",
    "onCommand:repoIntelligence.showCallers",
    "onCommand:repoIntelligence.showCallees",
    "onCommand:repoIntelligence.showBlastRadius",
    "onCommand:repoIntelligence.showImpactAnalysis",
    "onCommand:repoIntelligence.showReadingPathForFile",
    "onCommand:repoIntelligence.connectBackend",
    "onCommand:repoIntelligence.explorerRefresh",
    "onCommand:repoIntelligence.updateApiToken",
    "onCommand:repoIntelligence.search",
    "onCommand:repoIntelligence.reviewFile",
    "onCommand:repoIntelligence.reviewModule",
    "onCommand:repoIntelligence.reviewChanges",
    "onCommand:repoIntelligence.reviewStagedChanges",
    "onCommand:repoIntelligence.reviewRepository",
    "onCommand:repoIntelligence.showDependencyChain",
    "onCommand:repoIntelligence.explainFile",
    "onCommand:repoIntelligence.explainSymbol",
    "onCommand:repoIntelligence.showCallersInGraph",
    "onCommand:repoIntelligence.showCalleesInGraph",
    "onCommand:repoIntelligence.showBlastRadiusInGraph",
    "onCommand:repoIntelligence.showCallHierarchy"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "ARIA",
      "properties": {
        "repoIntelligence.backendUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8001",
          "description": "URL of the running ARIA backend."
        },
        "repoIntelligence.apiToken": {
          "type": "string",
          "default": "",
          "description": "Optional API token for authenticating with the backend."
        },
        "repoIntelligence.activeRepository": {
          "type": "string",
          "default": "",
          "description": "Active repository identifier (owner/repo)."
        },
        "repoIntelligence.autoRefresh": {
          "type": "boolean",
          "default": false,
          "description": "Automatically refresh analysis data on file save."
        },
        "repoIntelligence.requestTimeoutMs": {
          "type": "number",
          "default": 15000,
          "description": "HTTP request timeout in milliseconds."
        },
        "repoIntelligence.graphLayout": {
          "type": "string",
          "enum": [
            "dagre",
            "force",
            "radial"
          ],
          "default": "dagre",
          "description": "Default layout algorithm for interactive graphs."
        },
        "repoIntelligence.theme": {
          "type": "string",
          "enum": [
            "auto",
            "dark",
            "light"
          ],
          "default": "auto",
          "description": "Color theme for webview panels."
        },
        "repoIntelligence.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable CodeLens annotations above functions and classes."
        },
        "repoIntelligence.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable symbol intelligence hover cards."
        },
        "repoIntelligence.logLevel": {
          "type": "string",
          "enum": [
            "trace",
            "debug",
            "info",
            "warn",
            "error"
          ],
          "default": "info",
          "description": "Log level for the ARIA output channel."
        }
      }
    },
    "commands": [
      {
        "command": "repoIntelligence.analyzeRepository",
        "title": "ARIA: Analyze Repository",
        "icon": "$(sync)"
      },
      {
        "command": "repoIntelligence.refreshAnalysis",
        "title": "ARIA: Refresh Analysis",
        "icon": "$(refresh)"
      },
      {
        "command": "repoIntelligence.setActiveRepository",
        "title": "ARIA: Set Active Repository",
        "icon": "$(repo)"
      },
      {
        "command": "repoIntelligence.showDependencyGraph",
        "title": "ARIA: Show Dependency Graph",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "repoIntelligence.showCallGraph",
        "title": "ARIA: Show Call Graph",
        "icon": "$(call-outgoing)"
      },
      {
        "command": "repoIntelligence.showAPISurface",
        "title": "ARIA: Show API Surface",
        "icon": "$(symbol-interface)"
      },
      {
        "command": "repoIntelligence.showRepositoryChat",
        "title": "ARIA: Open Repository Chat",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "repoIntelligence.showReadingPath",
        "title": "ARIA: Show Reading Path",
        "icon": "$(book)"
      },
      {
        "command": "repoIntelligence.openDashboard",
        "title": "ARIA: Open Dashboard",
        "icon": "$(dashboard)"
      },
      {
        "command": "repoIntelligence.openWorkspace",
        "title": "ARIA: Open Workspace",
        "icon": "$(layout)"
      },
      {
        "command": "repoIntelligence.openFindings",
        "title": "ARIA: Open Findings",
        "icon": "$(issues)"
      },
      {
        "command": "repoIntelligence.openAdvisor",
        "title": "ARIA: Open Advisor",
        "icon": "$(lightbulb)"
      },
      {
        "command": "repoIntelligence.openTimeline",
        "title": "ARIA: Open Timeline",
        "icon": "$(history)"
      },
      {
        "command": "repoIntelligence.openMonitoring",
        "title": "ARIA: Open Monitoring",
        "icon": "$(pulse)"
      },
      {
        "command": "repoIntelligence.openExecutionPlan",
        "title": "ARIA: Open Execution Plan",
        "icon": "$(tasklist)"
      },
      {
        "command": "repoIntelligence.refreshWorkspace",
        "title": "ARIA: Refresh Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "repoIntelligence.showCallers",
        "title": "Show Callers"
      },
      {
        "command": "repoIntelligence.showCallees",
        "title": "Show Callees"
      },
      {
        "command": "repoIntelligence.showBlastRadius",
        "title": "Show Blast Radius"
      },
      {
        "command": "repoIntelligence.showImpactAnalysis",
        "title": "Show Impact Analysis"
      },
      {
        "command": "repoIntelligence.showReadingPathForFile",
        "title": "Show Reading Path (this file)"
      },
      {
        "command": "repoIntelligence.connectBackend",
        "title": "ARIA: Connect to Backend",
        "icon": "$(plug)"
      },
      {
        "command": "repoIntelligence.explorerRefresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "repoIntelligence.updateApiToken",
        "title": "ARIA: Update API Token"
      },
      {
        "command": "repoIntelligence.nextReadingStep",
        "title": "ARIA: Next Reading Step",
        "icon": "$(arrow-right)"
      },
      {
        "command": "repoIntelligence.previousReadingStep",
        "title": "ARIA: Previous Reading Step",
        "icon": "$(arrow-left)"
      },
      {
        "command": "repoIntelligence.refreshRepository",
        "title": "ARIA: Refresh Repository",
        "icon": "$(refresh)"
      },
      {
        "command": "repoIntelligence.reconnectBackend",
        "title": "ARIA: Reconnect Backend",
        "icon": "$(plug)"
      },
      {
        "command": "repoIntelligence.askRepository",
        "title": "ARIA: Ask Repository",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "repoIntelligence.runInspection",
        "title": "ARIA: Run Inspection",
        "icon": "$(play)"
      },
      {
        "command": "repoIntelligence.runMonitoring",
        "title": "ARIA: Run Monitoring",
        "icon": "$(activity)"
      },
      {
        "command": "repoIntelligence.generateRoadmap",
        "title": "ARIA: Generate Roadmap",
        "icon": "$(lightbulb)"
      },
      {
        "command": "repoIntelligence.generateExecutionPlan",
        "title": "ARIA: Generate Execution Plan",
        "icon": "$(tasklist)"
      },
      {
        "command": "repoIntelligence.askAboutFile",
        "title": "ARIA: Ask About This File"
      },
      {
        "command": "repoIntelligence.findReferencesInGraph",
        "title": "ARIA: Find References in Repository Graph"
      },
      {
        "command": "repoIntelligence.inspectModule",
        "title": "ARIA: Inspect This Module"
      },
      {
        "command": "repoIntelligence.showCodeLensQuickPick",
        "title": "ARIA: Show CodeLens Actions"
      },
      {
        "command": "repoIntelligence.search",
        "title": "ARIA: Search",
        "icon": "$(search)"
      },
      {
        "command": "repoIntelligence.reviewFile",
        "title": "ARIA: Review Current File",
        "icon": "$(eye)"
      },
      {
        "command": "repoIntelligence.reviewModule",
        "title": "ARIA: Review Current Module",
        "icon": "$(eye)"
      },
      {
        "command": "repoIntelligence.reviewChanges",
        "title": "ARIA: Review Current Changes",
        "icon": "$(eye)"
      },
      {
        "command": "repoIntelligence.reviewStagedChanges",
        "title": "ARIA: Review Staged Changes",
        "icon": "$(eye)"
      },
      {
        "command": "repoIntelligence.reviewRepository",
        "title": "ARIA: Review Entire Repository",
        "icon": "$(eye)"
      },
      {
        "command": "repoIntelligence.showDependencyChain",
        "title": "ARIA: Show Dependency Chain",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "repoIntelligence.explainFile",
        "title": "ARIA: Explain File"
      },
      {
        "command": "repoIntelligence.explainSymbol",
        "title": "ARIA: Explain Symbol"
      },
      {
        "command": "repoIntelligence.showCallersInGraph",
        "title": "ARIA: Find Callers"
      },
      {
        "command": "repoIntelligence.showCalleesInGraph",
        "title": "ARIA: Find Callees"
      },
      {
        "command": "repoIntelligence.showBlastRadiusInGraph",
        "title": "ARIA: Show Blast Radius"
      },
      {
        "command": "repoIntelligence.showCallHierarchy",
        "title": "ARIA: Show Call Hierarchy"
      },
      {
        "command": "repoIntelligence.advisorOpenFile",
        "title": "Open File"
      },
      {
        "command": "repoIntelligence.advisorShowReasoning",
        "title": "Show Reasoning"
      },
      {
        "command": "repoIntelligence.advisorShowEvidence",
        "title": "Show Evidence"
      },
      {
        "command": "repoIntelligence.advisorIgnore",
        "title": "Ignore Recommendation"
      },
      {
        "command": "repoIntelligence.executionOpenTask",
        "title": "Open Task"
      },
      {
        "command": "repoIntelligence.executionNextTask",
        "title": "Next Task"
      },
      {
        "command": "repoIntelligence.executionPreviousTask",
        "title": "Previous Task"
      },
      {
        "command": "repoIntelligence.executionShowCriticalPath",
        "title": "Show Critical Path"
      },
      {
        "command": "repoIntelligence.executionShowRollback",
        "title": "Show Rollback Checkpoint"
      },
      {
        "command": "repoIntelligence.runSelfDiagnostics",
        "title": "ARIA: Run Self Diagnostics"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "repoIntelligence",
          "title": "ARIA",
          "icon": "resources/activity-bar-icon.svg"
        }
      ]
    },
    "views": {
      "repoIntelligence": [
        {
          "id": "repoIntelligenceExplorer",
          "name": "Repository Explorer",
          "when": "true"
        },
        {
          "id": "repoIntelligenceFindings",
          "name": "Engineering Findings",
          "when": "true"
        },
        {
          "id": "repoIntelligenceAdvisor",
          "name": "Advisor Dashboard",
          "when": "true"
        },
        {
          "id": "repoIntelligenceExecution",
          "name": "Execution Planner",
          "when": "true"
        },
        {
          "id": "repoIntelligenceConnection",
          "name": "Backend Connection",
          "when": "true"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "repoIntelligence.explorerRefresh",
          "when": "view == repoIntelligenceExplorer",
          "group": "navigation"
        },
        {
          "command": "repoIntelligence.openDashboard",
          "when": "view == repoIntelligenceExplorer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "repoIntelligence.showCallers",
          "when": "false"
        },
        {
          "command": "repoIntelligence.showCallees",
          "when": "false"
        },
        {
          "command": "repoIntelligence.showBlastRadius",
          "when": "false"
        },
        {
          "command": "repoIntelligence.showImpactAnalysis",
          "when": "false"
        },
        {
          "command": "repoIntelligence.showReadingPathForFile",
          "when": "false"
        },
        {
          "command": "repoIntelligence.advisorOpenFile",
          "when": "false"
        },
        {
          "command": "repoIntelligence.advisorShowReasoning",
          "when": "false"
        },
        {
          "command": "repoIntelligence.advisorShowEvidence",
          "when": "false"
        },
        {
          "command": "repoIntelligence.advisorIgnore",
          "when": "false"
        },
        {
          "command": "repoIntelligence.executionOpenTask",
          "when": "false"
        },
        {
          "command": "repoIntelligence.executionNextTask",
          "when": "false"
        },
        {
          "command": "repoIntelligence.executionPreviousTask",
          "when": "false"
        },
        {
          "command": "repoIntelligence.executionShowCriticalPath",
          "when": "false"
        },
        {
          "command": "repoIntelligence.executionShowRollback",
          "when": "false"
        }
      ],
      "explorer/context": [
        {
          "command": "repoIntelligence.askAboutFile",
          "group": "navigation"
        },
        {
          "command": "repoIntelligence.findReferencesInGraph",
          "group": "navigation"
        },
        {
          "command": "repoIntelligence.inspectModule",
          "group": "navigation"
        },
        {
          "command": "repoIntelligence.reviewFile",
          "group": "navigation"
        },
        {
          "command": "repoIntelligence.reviewModule",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "repoIntelligence.explainSymbol",
          "group": "navigation"
        },
        {
          "command": "repoIntelligence.explainFile",
          "group": "navigation"
        },
        {
          "command": "repoIntelligence.askAboutFile",
          "group": "navigation"
        },
        {
          "command": "repoIntelligence.showBlastRadius",
          "group": "navigation"
        },
        {
          "command": "repoIntelligence.showCallHierarchy",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "repoIntelligence.advisorOpenFile",
          "when": "viewItem == recommendation",
          "group": "inline"
        },
        {
          "command": "repoIntelligence.advisorShowReasoning",
          "when": "viewItem == recommendation",
          "group": "inline"
        },
        {
          "command": "repoIntelligence.advisorShowEvidence",
          "when": "viewItem == recommendation",
          "group": "inline"
        },
        {
          "command": "repoIntelligence.advisorIgnore",
          "when": "viewItem == recommendation",
          "group": "inline"
        },
        {
          "command": "repoIntelligence.executionOpenTask",
          "when": "viewItem == task",
          "group": "inline"
        },
        {
          "command": "repoIntelligence.executionNextTask",
          "when": "viewItem == task",
          "group": "inline"
        },
        {
          "command": "repoIntelligence.executionPreviousTask",
          "when": "viewItem == task",
          "group": "inline"
        },
        {
          "command": "repoIntelligence.executionShowCriticalPath",
          "when": "viewItem == task",
          "group": "inline"
        },
        {
          "command": "repoIntelligence.executionShowRollback",
          "when": "viewItem == task",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "test": "npm run compile && npx mocha --require module-alias/register out/test/api.test.js out/test/commands.test.js out/test/graph.test.js out/test/providers.test.js out/test/settings.test.js out/test/chat.test.js out/test/workspaceViews.test.js out/test/foundation.test.js out/test/developerExperience.test.js out/test/aiAssistant.test.js out/test/hardening.test.js out/test/noFabricatedWebviews.test.js",
    "test:integration": "npm run compile && npx mocha --require module-alias/register out/test/chat.integration.test.js",
    "lint": "eslint src --ext .ts",
    "pretest": "npm run compile"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vscode/test-electron": "^2.3.9",
    "@vscode/vsce": "^2.24.0",
    "eslint": "^8.56.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "module-alias": "^2.2.3"
  },
  "_moduleAliases": {
    "vscode": "./out/test/mocks/vscode.js"
  }
}
