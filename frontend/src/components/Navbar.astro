---
const pathname = new URL(Astro.request.url).pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/issues', label: 'Issues' },
  { href: '/chat', label: 'Chat' },
];
---
{/*
  Blur and opacity arrive on scroll rather than being permanent: at the top of the
  hero the header should sit on the canvas almost invisibly, and only become a
  surface once content is passing underneath it.
*/}
<header
  id="site-nav"
  class="w-full border-b border-white/[0.03] bg-canvas/40 nav-wake
         transition-[background-color,border-color,backdrop-filter] duration-300"
>
  <div class="mx-auto flex h-16 sm:h-[4.5rem] max-w-7xl items-center justify-between px-5 sm:px-6 lg:px-8">
    <!-- Brand -->
    <div class="flex items-center gap-10">
      <a href="/" class="flex items-center gap-3 group focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary rounded px-1.5 py-1 -mx-1.5" aria-label="ARIA Home">
        <span class="h-2 w-2 rounded-full bg-primary status-dot brand-signal" aria-hidden="true"></span>
        <span class="text-[14px] font-bold tracking-[0.24em] text-text font-mono uppercase">ARIA</span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-8" aria-label="Primary">
        {navLinks.map(link => {
          const isActive = pathname === link.href;
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class={`text-[11px] font-mono tracking-[0.16em] transition-colors duration-200 uppercase focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary rounded px-1.5 py-0.5 ${
                isActive ? 'text-text' : 'text-text-subtle hover:text-text-muted'
              }`}
            >
              {link.label}
            </a>
          );
        })}
        <!-- Points at the active repository once one is indexed, otherwise at the analyzer. -->
        <a
          id="analysis-nav-link"
          href="/#analyze"
          class="text-[11px] font-mono tracking-[0.16em] transition-colors duration-300 text-text-subtle hover:text-text-muted uppercase focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary rounded px-1.5 py-0.5"
        >
          Analysis
        </a>
      </nav>
    </div>

    <!-- Right-hand status & actions -->
    <div class="flex items-center gap-3.5">
      <div
        id="backend-status-container"
        class="hidden sm:flex items-center gap-2 text-[10px] font-mono text-text-subtle tracking-[0.2em]"
        role="status"
        aria-live="polite"
      >
        <span id="backend-status-dot" class="h-1.5 w-1.5 rounded-full bg-text-subtle" aria-hidden="true"></span>
        <span id="backend-status-label" class="uppercase">ENGINE READY</span>
      </div>

      <div class="hidden sm:block h-3 w-px bg-white/[0.06]" aria-hidden="true"></div>

      <a
        href="https://github.com/VarshithReddy2006/Repo-Intelligence-Agent"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="View ARIA on GitHub"
        class="flex items-center gap-1 text-text-subtle hover:text-text transition-colors duration-200 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary rounded p-1"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
      </a>

      <!-- Mobile hamburger -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden flex items-center justify-center h-7 w-7 rounded border border-white/[0.06]
               text-text-subtle hover:text-text hover:border-white/[0.12] transition-colors
               focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-primary"
        aria-label="Open navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav-dialog"
      >
        <svg id="hamburger-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
      </button>
    </div>
  </div>

  <!-- Reading progress rail (driven by the landing page script) -->
  <span
    id="nav-progress"
    class="absolute bottom-0 left-0 h-px w-full origin-left scale-x-0 bg-primary/60"
    aria-hidden="true"
  ></span>
</header>

<!-- Mobile Navigation Dialog -->
<dialog
  id="mobile-nav-dialog"
  class="fixed inset-0 z-[60] m-0 p-0 w-full h-full bg-transparent"
  aria-label="Navigation menu"
>
  <!-- Backdrop -->
  <div id="mobile-nav-backdrop" class="absolute inset-0 bg-canvas/80 backdrop-blur-sm"></div>

  <!-- Drawer panel -->
  <div class="absolute top-0 left-0 h-full w-72 bg-surface-1 border-r border-white/[0.04] flex flex-col shadow-float">
    <!-- Header -->
    <div class="flex items-center justify-between px-5 h-16 border-b border-white/[0.04]">
      <span class="text-sm font-mono font-bold text-text uppercase tracking-wide">ARIA</span>
      <button
        id="mobile-nav-close"
        type="button"
        class="flex items-center justify-center h-7 w-7 rounded-md text-text-subtle hover:text-text
               hover:bg-white/[0.04] transition-colors focus-visible:outline-none focus-visible:shadow-ring"
        aria-label="Close navigation menu"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Links -->
    <nav class="flex flex-col gap-1 p-3 flex-grow" aria-label="Mobile primary navigation">
      {navLinks.map(link => {
        const isActive = pathname === link.href;
        return (
          <a
            href={link.href}
            aria-current={isActive ? 'page' : undefined}
            class={`flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium transition-colors ${
              isActive
                ? 'bg-primary/10 text-primary border border-primary/20'
                : 'text-text-muted hover:text-text hover:bg-white/[0.03]'
            }`}
          >
            {link.label}
          </a>
        );
      })}
      <a
        id="mobile-analysis-link"
        href="/analysis"
        class="flex items-center gap-2.5 px-3 py-2.5 rounded-lg text-sm font-medium text-text-muted hover:text-text hover:bg-white/[0.03] transition-colors hidden"
      >
        Analysis Dashboard
      </a>
    </nav>
  </div>
</dialog>

<script>
  import { getEngineStatus } from '../lib/api';

  let currentOverrideStatus: string | null = null;

  // ── Contextual Backend Engine status ───────────────────────────────────────
  async function updateStatus() {
    const dot   = document.getElementById('backend-status-dot');
    const label = document.getElementById('backend-status-label');
    if (!dot || !label) return;

    if (currentOverrideStatus === 'ANALYZING') {
      // `animate-ping` threw an expanding ring well outside the 6px dot and read
      // as an alert. A slow opacity breath says "working" without shouting.
      dot.className = 'h-1.5 w-1.5 rounded-full bg-primary status-dot';
      label.textContent = 'ANALYZING';
      label.className = 'text-primary uppercase font-bold';
      return;
    }

    const hasActiveRepo = Boolean(localStorage.getItem('activeRepo'));
    const res = await getEngineStatus();
    switch (res.state) {
      case 'indexed':
        if (hasActiveRepo) {
          // RepoContextBar is actively displaying repository identity and INDEXED status.
          // Keep navbar status quiet and informational rather than duplicating the exact same badge.
          dot.className = 'h-1.5 w-1.5 rounded-full bg-primary';
          label.textContent = 'ENGINE READY';
          label.className = 'text-text-subtle uppercase font-semibold';
        } else {
          dot.className = 'h-1.5 w-1.5 rounded-full bg-emerald-400';
          label.textContent = 'INDEXED';
          label.className = 'text-emerald-400 uppercase font-semibold';
        }
        break;
      case 'ready':
        dot.className = 'h-1.5 w-1.5 rounded-full bg-primary';
        label.textContent = 'ENGINE READY';
        label.className = 'text-primary uppercase font-semibold';
        break;
      case 'degraded':
        dot.className = 'h-1.5 w-1.5 rounded-full bg-amber-400';
        label.textContent = 'DEGRADED';
        label.className = 'text-amber-400 uppercase font-semibold';
        break;
      case 'offline':
      default:
        dot.className = 'h-1.5 w-1.5 rounded-full bg-danger animate-pulse';
        label.textContent = 'OFFLINE';
        label.className = 'text-danger uppercase';
        break;
    }
  }

  // Listen for analysis lifecycle events
  window.addEventListener('aria-analysis-started', () => {
    currentOverrideStatus = 'ANALYZING';
    updateStatus();
  });
  window.addEventListener('aria-analysis-completed', () => {
    currentOverrideStatus = null;
    updateStatus();
  });

  // ── Analysis nav link ────────────────────────────────────────────────────
  function setupNavbar() {
    const analysisLink   = document.getElementById('analysis-nav-link');
    const mobileLink     = document.getElementById('mobile-analysis-link');

    /**
     * Analysis stays visible at all times. With an indexed repository it opens
     * that repository's dashboard; without one it takes the visitor to the
     * analyzer at the end of the landing story, since /analysis needs a target.
     */
    function updateLinks(activeRepo: string | null) {
      const [owner, repo] = (activeRepo ?? '').split('/');
      const hasTarget = Boolean(owner && repo);
      const href = hasTarget ? `/analysis?owner=${owner}&repo=${repo}` : '/#analyze';

      if (analysisLink) {
        analysisLink.setAttribute('href', href);
        analysisLink.classList.remove('hidden');

        const isAnalysisPage = window.location.pathname.startsWith('/analysis');
        if (isAnalysisPage) {
          analysisLink.setAttribute('aria-current', 'page');
          analysisLink.classList.add('text-text');
          analysisLink.classList.remove('text-text-subtle');
        } else {
          analysisLink.removeAttribute('aria-current');
          analysisLink.classList.remove('text-text');
          analysisLink.classList.add('text-text-subtle');
        }
      }

      if (mobileLink) {
        mobileLink.setAttribute('href', href);
        mobileLink.classList.remove('hidden');
        mobileLink.textContent = hasTarget ? 'Analysis Dashboard' : 'Analyze a Repository';
      }
    }

    const activeRepo = localStorage.getItem('activeRepo');
    updateLinks(activeRepo);

    // Listen for custom events to update state instantly across pages/islands
    window.addEventListener('active-repo-changed', (e: any) => {
      updateLinks(e.detail);
    });

    window.addEventListener('active-repo-cleared', () => {
      updateLinks(null);
    });
  }

  // ── Mobile menu ──────────────────────────────────────────────────────────
  function setupMobileMenu() {
    const btn     = document.getElementById('mobile-menu-btn');
    const dialog  = document.getElementById('mobile-nav-dialog') as HTMLDialogElement | null;
    const closeBtn= document.getElementById('mobile-nav-close');
    const backdrop= document.getElementById('mobile-nav-backdrop');
    if (!btn || !dialog || !closeBtn || !backdrop) return;

    function openMenu() {
      dialog!.showModal();
      btn!.setAttribute('aria-expanded', 'true');
    }

    // Safely handle closing menu
    const closeMenu = () => {
      if (dialog && dialog.open) {
        dialog.close();
      }
      if (btn) {
        btn.setAttribute('aria-expanded', 'false');
      }
    };

    btn.addEventListener('click', openMenu);
    closeBtn.addEventListener('click', closeMenu);
    backdrop.addEventListener('click', closeMenu);
    dialog.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Escape') closeMenu();
    });

    // Also support custom event closures
    window.addEventListener('active-repo-cleared', closeMenu);
  }

  // ── Scroll-reactive chrome + reading progress ────────────────────────────
  // Lives here rather than on a single page so every route gets the same
  // persistent environment. One rAF-throttled handler drives both.
  function setupScrollState() {
    const nav = document.getElementById('site-nav');
    const bar = document.getElementById('nav-progress');
    if (!nav) return;

    let frame = 0;
    const apply = () => {
      frame = 0;

      const scrolled = window.scrollY > 24;
      nav.classList.toggle('bg-canvas/85', scrolled);
      nav.classList.toggle('bg-canvas/40', !scrolled);
      nav.classList.toggle('border-white/[0.06]', scrolled);
      nav.classList.toggle('border-white/[0.03]', !scrolled);
      // The blur is part of the scrolled state, not the resting one.
      nav.classList.toggle('backdrop-blur-xl', scrolled);

      if (bar) {
        const max = document.documentElement.scrollHeight - window.innerHeight;
        const ratio = max > 8 ? window.scrollY / max : 0;
        bar.style.transform = `scaleX(${Math.min(1, Math.max(0, ratio))})`;
      }
    };

    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(apply);
    };

    apply();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }

  let pollTimer: ReturnType<typeof setInterval> | null = null;

  function startPolling() {
    if (pollTimer) return;
    pollTimer = setInterval(() => {
      if (!document.hidden) {
        updateStatus();
      }
    }, 8000);
  }

  function stopPolling() {
    if (pollTimer) {
      clearInterval(pollTimer);
      pollTimer = null;
    }
  }

  document.addEventListener('visibilitychange', () => {
    if (document.hidden) {
      stopPolling();
    } else {
      updateStatus();
      startPolling();
    }
  });

  updateStatus();
  startPolling();
  setupNavbar();
  setupMobileMenu();
  setupScrollState();
</script>
