---
import HeroGraph from '../interactive/HeroGraph';
import { scene } from './sceneModel';

/** Scroll duration for the opening scene, from the shared model. */
const heroScene = scene('hero');

/**
 * HeroStage — chapter 01.
 *
 * The opening frame of a codebase awakening. The repository starts opaque: a
 * soft indigo light behind the type, a topology at almost no presence, and a
 * headline that is revealed rather than dropped onto the page.
 *
 * No repository input here by design — the visitor meets the idea first and is
 * asked for a repository only in the final chapter, where the command surface
 * carries the full terminal treatment.
 */

/** Paths that surface and recede behind the headline, on their own cadence. */
const paths = [
  { text: 'services/analysis_orchestrator.py', top: '22%', right: '6%', delay: '0s' },
  { text: 'core/dependency_graph.py', top: '38%', right: '14%', delay: '3.6s' },
  { text: 'models/schemas.py', top: '64%', right: '9%', delay: '7.2s' },
  { text: 'mcp/tools/search_tools.py', top: '78%', right: '20%', delay: '10.8s' },
];

/**
 * Capability telemetry. Every entry is a technique ARIA genuinely implements, so
 * the headline's claim and the product are connected before the visitor scrolls.
 */
const telemetry = [
  'AST PARSING',
  'DEPENDENCY GRAPHS',
  'CALL GRAPHS',
  'RAG',
  'IMPACT ANALYSIS',
];
---

{/*
  Scene 01. The section is the scroll space; `.scene-stage` inside it is the pinned
  frame. The hero's own layers (topology, bloom, pointer light) live on the stage
  so they are clipped to the frame rather than to the whole scroll space.
*/}
<section
  id="hero"
  data-stage="hero"
  data-pin="on"
  style={`--scene-vh:${heroScene.vh};--scene-vh-compact:${heroScene.vhCompact}`}
  aria-labelledby="hero-heading"
>
<div
  class="hero-stage scene-stage relative overflow-hidden"
>
  {/*
    Repository topology. The outer layer answers scroll, the inner one performs
    the emergence, so neither transform fights the other.
  */}
  <div class="hero-topology absolute inset-0 z-0" aria-hidden="true">
    <div class="hero-topology-emerge h-full w-full" data-hero-topology>
      <HeroGraph client:only="react" className="w-full h-full" />
    </div>
  </div>

  <!-- Cinematic light behind the typography -->
  <div class="hero-bloom z-0" aria-hidden="true">
    <div class="hero-bloom-drift h-full w-full"></div>
  </div>

  {/*
    Pointer light. The topology beneath already displaces its nodes around the
    cursor; this gives that reaction a source, so moving across the hero reads as
    illuminating a dark system.
  */}
  <div class="hero-pointer z-0" aria-hidden="true"></div>

  <!-- File paths surfacing in the background — scroll displacement with glass sheen -->
  <div class="absolute inset-0 z-0 hidden md:block pointer-events-none" aria-hidden="true">
    {paths.map((p) => (
      <span
        class="hero-path absolute font-mono text-[11px] tracking-wide text-slate-400/80 px-2.5 py-1 rounded-md bg-[#0A0D14]/60 border border-white/[0.05] backdrop-blur-md shadow-sm whitespace-nowrap"
        style={`top:${p.top};right:${p.right};`}
      >
        <span class="text-[#818CF8]/80 mr-1.5 font-bold">λ</span>
        {p.text}
      </span>
    ))}
  </div>

  <!-- Technical instrument corner marks with luminous accents -->
  <span class="tech-cross top-6 left-6 hidden md:block" aria-hidden="true"></span>
  <span class="tech-cross top-6 right-6 hidden md:block" aria-hidden="true"></span>
  <span class="tech-cross bottom-6 left-6 hidden md:block" aria-hidden="true"></span>
  <span class="tech-cross bottom-6 right-6 hidden md:block" aria-hidden="true"></span>

  <!-- Content -->
  <div class="story-shell relative z-10 py-2 sm:py-4">
    <!-- Eyebrow -->
    <div class="hero-enter-eyebrow flex items-center gap-4 mb-2 sm:mb-4">
      <span class="h-px w-8 bg-gradient-to-r from-[#818CF8] to-[#818CF8]/20 shadow-[0_0_8px_rgba(129,140,248,0.6)]" aria-hidden="true"></span>
      <span class="mono-label text-[#818CF8] font-bold tracking-[0.22em] text-[11px] flex items-center gap-2">
        <span class="h-1.5 w-1.5 rounded-full bg-[#818CF8] shadow-[0_0_8px_rgba(129,140,248,0.8)] animate-pulse"></span>
        REPOSITORY INTELLIGENCE
      </span>
      <span class="mono-label text-[9.5px] text-[#64748B] hidden sm:inline-block ml-auto tracking-[0.25em]" aria-hidden="true">SYS.ID // ARIA-TOPO-01</span>
    </div>

    {/*
      Display headline. Chromatic white-to-indigo gradient with animated specular shine.
    */}
    <h1 id="hero-heading" class="display-hero text-text select-none">
      <span class="reveal-mask">
        <span class="hero-line--lead" style="animation-delay:650ms">Understand</span>
      </span>
      <span class="reveal-mask">
        <span class="hero-line--resolve" style="animation-delay:850ms">Any codebase.</span>
      </span>
    </h1>

    <!-- Capability telemetry — floating 3D glass capsules with vivid neon beacons -->
    <div class="hero-telemetry mono-label mt-4 sm:mt-5 flex flex-wrap items-center gap-2 sm:gap-2.5 max-w-4xl" style="letter-spacing:0.16em">
      {telemetry.map((item, i) => (
        <span
          class="telemetry-pill group inline-flex items-center gap-2 px-2.5 py-1 rounded-lg border border-white/[0.08] bg-gradient-to-r from-[#0D1220]/90 to-[#0A0D14]/90 backdrop-blur-xl shadow-lg hover:border-[#818CF8]/40 hover:shadow-[0_0_20px_rgba(129,140,248,0.20)] hover:-translate-y-0.5 transition-all duration-300"
          style={`--tel-delay:${1050 + i * 80}ms`}
        >
          <span
            class="h-1.5 w-1.5 rounded-full shrink-0 group-hover:scale-125 transition-transform duration-300"
            style={{
              background: i === 0 ? '#34D399' : i === 1 ? '#818CF8' : i === 2 ? '#38BDF8' : i === 3 ? '#FCD34D' : '#FF758F',
              boxShadow: `0 0 8px ${i === 0 ? 'rgba(52,211,153,0.8)' : i === 1 ? 'rgba(129,140,248,0.8)' : i === 2 ? 'rgba(56,189,248,0.8)' : i === 3 ? 'rgba(252,211,77,0.8)' : 'rgba(255,117,143,0.8)'}`,
            }}
            aria-hidden="true"
          ></span>
          <span class="text-[#E2E8F0] font-mono text-[9.5px] font-semibold tracking-wider uppercase group-hover:text-white transition-colors">
            {item}
          </span>
        </span>
      ))}
    </div>

    <!-- Supporting text + CTAs -->
    <div class="mt-5 sm:mt-8 max-w-2xl">
      <p class="hero-enter-body story-lead text-[14px] sm:text-[16px] text-[#CBD5E1] leading-relaxed font-sans">
        ARIA maps files, symbols, dependencies, call relationships, and change impact into evidence-backed engineering intelligence.
      </p>

      <!-- Hero Actions with living border beams -->
      <div class="hero-enter-cta mt-6 flex flex-wrap items-center gap-3.5">
        <a
          href="/analysis?owner=fastapi&repo=fastapi"
          class="cta-light-sweep relative group inline-flex items-center gap-2.5 px-6 py-3 rounded-lg border border-[#818CF8]/50 bg-gradient-to-r from-[#131A2E] to-[#0A0D14] hover:border-[#A5B4FC] text-white font-mono text-xs font-bold tracking-wider transition-all duration-300 shadow-[0_0_24px_rgba(129,140,248,0.25)] hover:shadow-[0_0_36px_rgba(129,140,248,0.45)] hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#818CF8]"
        >
          <span class="relative z-10 tracking-widest font-mono">EXPLORE ARIA</span>
          <span class="relative z-10 text-[#818CF8] group-hover:text-white group-hover:translate-x-1 transition-all duration-300">→</span>
        </a>

        <a
          href="https://github.com/VarshithReddy2006/ARIA"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-lg border border-white/[0.08] bg-[#0A0D14]/80 hover:bg-[#0D1220] hover:border-white/[0.18] text-[#CBD5E1] hover:text-white font-mono text-xs tracking-wider transition-all duration-200 backdrop-blur-xl shadow-md hover:-translate-y-0.5 focus-visible:outline-none focus-visible:ring-1 focus-visible:ring-[#818CF8]"
        >
          <span>VIEW SOURCE</span>
          <span class="text-[#94A3B8] group-hover:text-white transition-colors">↗</span>
        </a>
      </div>

      <div class="mt-5 flex flex-wrap items-center gap-3">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-md bg-[#0A0D14]/80 border border-white/[0.06] backdrop-blur-md">
          <span class="h-1.5 w-1.5 rounded-full bg-[#34D399] shadow-[0_0_8px_rgba(52,211,153,0.8)] animate-pulse" aria-hidden="true"></span>
          <span class="mono-label text-[10px] text-[#CBD5E1] font-semibold">DETERMINISTIC ANALYSIS</span>
        </div>
        <span class="mono-label text-[9.5px] text-[#64748B]">PRESS ⌘K TO SEARCH</span>
      </div>
    </div>
  </div>
</div>
</section>

<script>
  /**
   * Hero scroll response.
   *
   * `--hero-p` is 0 at the top of the page and 1 once the hero has been scrolled
   * fully past. It drives the light source and the topology recession through
   * CSS, so nothing here touches layout: no getBoundingClientRect, no reads
   * inside the listener, and a rAF gate so the work happens once per frame at
   * most.
   */
  function initHero() {
    const hero = document.querySelector<HTMLElement>('.hero-stage');
    if (!hero || hero.dataset.bound === 'true') return;
    hero.dataset.bound = 'true';

    const topology = hero.querySelector<HTMLElement>('[data-hero-topology]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // The topology emerges once, shortly after the headline begins to resolve.
    if (topology) {
      if (reduced) topology.classList.add('is-emerged');
      else requestAnimationFrame(() => topology.classList.add('is-emerged'));
    }

    if (reduced) return;

    let raf = 0;

    const apply = () => {
      raf = 0;
      // Height of the hero is ~1 viewport, so viewport-relative scroll is a good
      // enough proxy and costs no layout read.
      const p = Math.min(1, Math.max(0, window.scrollY / (window.innerHeight || 1)));
      hero.style.setProperty('--hero-p', p.toFixed(4));
    };

    const onScroll = () => {
      if (!raf) raf = requestAnimationFrame(apply);
    };

    apply();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });

    /*
      Pointer light. Percentages rather than pixels, so the gradient needs no
      knowledge of the hero's size and a resize cannot desynchronise it. One rAF
      gate, two property writes, and one layout read per pointer event — which is
      unavoidable for a position relative to a specific element, and is confined
      to the hero.
    */
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      let mRaf = 0;
      let mx = 50;
      let my = 55;

      const paint = () => {
        mRaf = 0;
        hero.style.setProperty('--mx', `${mx.toFixed(2)}%`);
        hero.style.setProperty('--my', `${my.toFixed(2)}%`);
      };

      hero.addEventListener(
        'pointermove',
        (event) => {
          const r = hero.getBoundingClientRect();
          if (r.width === 0 || r.height === 0) return;
          mx = ((event.clientX - r.left) / r.width) * 100;
          my = ((event.clientY - r.top) / r.height) * 100;
          hero.classList.add('is-lit');
          if (!mRaf) mRaf = requestAnimationFrame(paint);
        },
        { passive: true }
      );

      hero.addEventListener('pointerleave', () => hero.classList.remove('is-lit'), {
        passive: true,
      });
    }
  }

  initHero();
  document.addEventListener('astro:page-load', initHero);
</script>
