---
import Layout from '../layouts/Layout.astro';
import IssueMapper from '../components/interactive/IssueMapper';
---

<Layout title="Issue Mapping — ARIA">
  {/*
    The header now lives inside IssueMapper so the standalone page and the
    Analysis tab present the same surface. `overflow-x-clip` guarantees no child
    can produce a document-level horizontal scrollbar.
  */}
  <div class="flex-grow flex flex-col w-full overflow-x-clip">
    <div class="instrument-shell py-6 sm:py-8">
      <IssueMapper client:load />
    </div>
  </div>
</Layout>
