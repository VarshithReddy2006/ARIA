---
import Layout from '../layouts/Layout.astro';
import ChatInterface from '../components/interactive/ChatInterface';
---

<Layout title="Repository Memory & Chat — ARIA">
  <div class="space-y-6 w-full py-6 flex flex-col flex-grow items-center max-w-4xl mx-auto px-4 sm:px-6">
    {/* Editorial Page Header */}
    <div class="border-b border-white/[0.04] pb-6 w-full space-y-2">
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-mono font-bold uppercase tracking-[0.25em] text-primary">
          03 — REPOSITORY MEMORY
        </span>
        <div
          id="chat-repo-badge"
          class="hidden shrink-0 text-[11px] font-mono border border-primary/30 text-primary px-2.5 py-0.5 rounded bg-primary/5"
          aria-live="polite"
        ></div>
      </div>

      <h1 class="text-2xl sm:text-3xl font-extrabold text-text tracking-tight font-mono uppercase">
        ASK THE CODEBASE.
      </h1>
      <p class="text-xs sm:text-sm text-text-muted font-sans leading-relaxed max-w-2xl">
        Conversational responses grounded in tree-sitter symbol graphs, strictly cited file by file.
      </p>
    </div>

    {/* Chat Interface react island */}
    <div class="w-full flex-grow flex flex-col">
      <ChatInterface repoName="" client:only="react" />
    </div>
  </div>
</Layout>

<script>
  function initChatBadge() {
    const badge = document.getElementById('chat-repo-badge');
    if (!badge) return;
    const repo = localStorage.getItem('activeRepo');
    if (repo) {
      badge.textContent = repo;
      badge.classList.remove('hidden');
    }
  }
  initChatBadge();
  document.addEventListener('astro:page-load', initChatBadge);
  window.addEventListener('active-repo-changed', (e: any) => {
    const badge = document.getElementById('chat-repo-badge');
    if (badge && e.detail) {
      badge.textContent = e.detail;
      badge.classList.remove('hidden');
    }
  });
</script>
