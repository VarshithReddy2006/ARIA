---
import Navbar from '../components/Navbar.astro';
import RepoContextBar from '../components/RepoContextBar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ARIA — Repository Intelligence Agent',
  description = 'Understand any codebase in minutes. ARIA transforms complex repositories into structured, searchable engineering intelligence.',
} = Astro.props;

const year = new Date().getFullYear();
const canonical = Astro.url.href;
---

<!DOCTYPE html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#030303" />

    <!-- Canonical / Social -->
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <!--
      Favicon. SVG only: the .ico alternate pointed at a file that has never
      existed in this project, so every page load logged a 404.
    -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Fonts — preload Inter + JetBrains Mono to eliminate FOUT -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-canvas text-text min-h-screen flex flex-col selection:bg-primary/20 selection:text-white">
    <!-- Skip link for keyboard/screen-reader users -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[9999]
             focus:px-4 focus:py-2 focus:rounded-md focus:bg-primary focus:text-white
             focus:text-sm focus:font-semibold focus:shadow-float"
    >
      Skip to main content
    </a>

    <div id="sticky-header-shell" class="sticky top-0 z-50 w-full">
      <Navbar />
      <RepoContextBar />
    </div>

    <main id="main-content" class="flex-grow flex flex-col w-full">
      <slot />
    </main>

    <footer class="w-full border-t border-white/[0.08] py-6 mt-16 bg-surface-1/40 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row justify-between items-center gap-3 text-xs text-text-muted font-mono tracking-wider">
        <p class="text-text-muted hover:text-text transition-colors duration-200">© {year} ARIA</p>
        <p class="flex items-center gap-2 text-text-muted hover:text-text transition-colors duration-200">
          <span class="inline-block h-1.5 w-1.5 rounded-full bg-primary shadow-[0_0_8px_rgba(94,106,210,0.6)]" aria-hidden="true"></span>
          REPOSITORY INTELLIGENCE
        </p>
      </div>
    </footer>
  </body>
</html>
