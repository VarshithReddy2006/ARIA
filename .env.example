# =============================================================================
# ARIA (AI-Powered Repo Intelligence Agent) Configuration Template
# =============================================================================
# Copy this file to .env and provide your deployment-specific variables.
# NEVER commit real secret values to source control.

# =============================================================================
# 1. CORE & LLM PROVIDER CONFIGURATION (Required across all environments)
# =============================================================================
LLM_PROVIDER=gemini # "gemini" (default) or "deepseek"

# Google Gemini (Google AI Studio key starting with AIza...)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek V4 Flash via NVIDIA NIM (Alternative)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-flash

# GitHub Personal Access Token (Raises rate limit from 60 to 5000 req/hr)
GITHUB_TOKEN=your_github_token_here

# Embedding Configuration (BGE Small English v1.5 - 384 dimensions)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=256

# =============================================================================
# 2. ENVIRONMENT PROFILE: LOCAL DEVELOPMENT
# =============================================================================
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=human
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8001
PORT=8001
FRONTEND_URL=http://localhost:4321
ALLOWED_HOSTS=["*"]
RATE_LIMIT_PER_MINUTE=60

# Local Storage Paths
SQLITE_DB_PATH=data/repo_understanding.db
CHROMA_DB_PATH=data/chroma_db
CLONED_REPOS_PATH=

# Local Vector Store (Embedded Qdrant or Chroma fallback)
VECTOR_STORE_BACKEND=qdrant
VECTOR_STORE_ENABLE_FALLBACK=true
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=

# =============================================================================
# 3. ENVIRONMENT PROFILE: MODAL DEPLOYMENT (modal_app.py)
# =============================================================================
# In Modal, secrets are provided via modal.Secret.from_name("aria-secrets")
# Persistent storage is mounted at /app/data via modal.Volume("aria-data-vol")
# SQLITE_DB_PATH=/app/data/repo_understanding.db
# VECTOR_STORE_BACKEND=qdrant
# QDRANT_URL=
# QDRANT_API_KEY=

# =============================================================================
# 4. ENVIRONMENT PROFILE: AZURE CONTAINER APPS (Student Budget ~$100)
# =============================================================================
# Azure Container Apps Web & Worker Settings:
# APP_ENV=production
# LOG_FORMAT=json
# API_SERVER_PORT=8001
# PORT=8001
# JOB_EXECUTOR=azure
# AZURE_STORAGE_QUEUE_NAME=aria-analysis-jobs
# JOB_STATE_DIR=/app/data/jobs
# SQLITE_DB_PATH=/app/data/repo_understanding.db
# ANALYSIS_STORE_PATH=/app/data/analysis_store.json
# VECTOR_STORE_BACKEND=qdrant
# QDRANT_URL=https://<your-cluster>.qdrant.io
# FRONTEND_URL=https://aria-orpin-five.vercel.app
# ALLOWED_HOSTS=["aria-api.<env-domain>.azurecontainerapps.io", "*.<env-domain>.azurecontainerapps.io", "localhost", "127.0.0.1"]
# RATE_LIMIT_PER_MINUTE=120
