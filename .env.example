# =============================================================================
# ARIA — Configuration Template
# =============================================================================
# Copy to .env and fill in the REQUIRED values. Everything else has a working
# default and can be left alone.
#
#   cp .env.example .env
#
# Every variable below is read by core/config.py (Pydantic Settings). Defaults
# shown in comments are the defaults in that file, so this template and the
# implementation stay in step.
#
# NEVER commit real secret values to source control.

# =============================================================================
# REQUIRED
# =============================================================================

# One LLM provider key is required for chat, impact analysis and the advisor.
# Structural analysis (AST, graphs, dead code, embeddings) works without one.
GEMINI_API_KEY=your_gemini_api_key_here

# Shared secret for the API. Optional when APP_ENV=development.
# REQUIRED when APP_ENV=production — startup fails fast without it, and
# docker compose refuses to start.
API_KEY=local-dev-key

# =============================================================================
# STRONGLY RECOMMENDED
# =============================================================================

# Raises the GitHub rate limit from 60 to 5,000 req/hr and enables private repos.
GITHUB_TOKEN=

# =============================================================================
# APPLICATION
# =============================================================================
APP_ENV=development                     # development | test | production
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8001
PORT=8001                               # honoured by container entrypoints
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=human                        # human | json  (use json in production)
SLOW_REQUEST_THRESHOLD_SECONDS=2.0

# TrustedHost allowlist. The wildcard is REJECTED when APP_ENV=production.
ALLOWED_HOSTS=["*"]
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# FRONTEND / CORS
# =============================================================================

# Server-side: the browser origin allowed by CORS.
FRONTEND_URL=http://localhost:4321

# Client-side: the API URL baked into the browser bundle at BUILD time.
# Must be reachable from the browser, so it is a host URL and never a Docker
# service name.
PUBLIC_API_URL=http://localhost:8001

# Astro adapter. 'vercel' for the hosted deployment, 'node' for a standalone
# server (what Dockerfile.frontend builds). Set per-build, not usually in .env.
# ARIA_DEPLOY_TARGET=vercel

# Host port the dashboard container publishes (docker-compose.yml only).
FRONTEND_PORT=4321

# =============================================================================
# LLM PROVIDERS
# =============================================================================
LLM_PROVIDER=gemini                     # gemini | deepseek
LLM_PRIMARY_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=deepseek
LLM_FAILOVER_ENABLED=true

GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3-flash-preview,gemini-flash-lite-latest,gemini-2.5-flash

# DeepSeek V4 Flash via NVIDIA NIM (failover provider)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_MODEL=deepseek-ai/deepseek-v4-flash-0731

# Timeouts & circuit breaker
LLM_CONNECT_TIMEOUT=10.0
LLM_READ_TIMEOUT=45.0
LLM_TOTAL_TIMEOUT=60.0
LLM_CIRCUIT_BREAKER_COOLDOWN_SECONDS=60.0
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3

# =============================================================================
# EMBEDDINGS
# =============================================================================
# ~400 MB is downloaded on first run and cached under $HOME/.cache.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_BACKEND=onnx                   # onnx (production default) | pytorch
EMBEDDING_ONNX_QUANTIZATION=int8         # int8 (quantized) | fp32 | none
EMBEDDING_ONNX_THREADS=                  # leave empty for auto (recommended)
EMBEDDING_BATCH_SIZE=64
EMBEDDING_ENCODE_BATCH_SIZE=64
EMBEDDING_CACHE_SIZE=50000

# =============================================================================
# VECTOR STORE
# =============================================================================
VECTOR_STORE_BACKEND=qdrant             # qdrant | chroma
VECTOR_STORE_ENABLE_FALLBACK=true       # fall back to ChromaDB if Qdrant is down

# Local Qdrant. Inside Docker this must be the compose service name
# (http://qdrant:6333) — 127.0.0.1 resolves to the API container itself.
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_GRPC_PORT=6334
QDRANT_PREFER_GRPC=true                 # set false when only the HTTP port is exposed
QDRANT_TIMEOUT=10.0
QDRANT_RETRY_ATTEMPTS=2

# =============================================================================
# STORAGE PATHS
# =============================================================================
# Keep CLONED_REPOS_PATH outside the backend tree or uvicorn --reload will loop.
SQLITE_DB_PATH=data/repo_understanding.db
ANALYSIS_STORE_PATH=data/analysis_store.json
CHROMA_DB_PATH=data/chroma_db
CACHE_FILE_PATH=data/cache.json
CLONED_REPOS_PATH=data/cloned_repos

# =============================================================================
# ANALYSIS EXECUTION & CONCURRENCY
# =============================================================================
# local = in-process background thread (no separate worker container required).
JOB_EXECUTOR=local                      # local | modal | azure

# Max concurrent background analyses. Defaults to 1 for self-hosted CPU safety.
ARIA_MAX_CONCURRENT_ANALYSES=1

# Uvicorn worker processes. Unset => 1.
WORKER_COUNT=
ARIA_WORKERS=
WEB_CONCURRENCY=

BUILD_TIMEOUT=1800                      # seconds
CACHE_SIZE_LIMIT=1000

# =============================================================================
# PROFILE: MODAL DEPLOYMENT (modal_app.py)
# =============================================================================
# Secrets come from modal.Secret.from_name("aria-secrets"); persistent storage is
# mounted at /app/data via modal.Volume("aria-data-vol").
# SQLITE_DB_PATH=/app/data/repo_understanding.db
# VECTOR_STORE_BACKEND=qdrant
# QDRANT_URL=
# QDRANT_API_KEY=

# =============================================================================
# PROFILE: AZURE CONTAINER APPS (retired)
# =============================================================================
# Azure hosting has been retired in favour of the Docker Compose path.
# See .env.azure.example if you need the historical settings.
